/target
**/*.rs.bk
*.pdb

# Release artifacts, assembled by packaging/ and uploaded by CI. The icon
# master and the .ico cut from it are tracked; what is built out of them is not.
/dist

# What a failing snapshot test writes beside the baseline it disagreed with.
# The baselines are tracked; these two are the evidence, not the record.
crates/remu-desk/tests/snapshots/*.diff.png
crates/remu-desk/tests/snapshots/*.new.png
crates/remu-desk/tests/snapshots/*.old.png

__pycache__/

# Editor / OS noise
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Local config that must never be committed: it can hold a relay token
# and an unattended-access password.
/.env
*.local.toml
