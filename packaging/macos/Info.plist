<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Remu.app's property list. packaging/macos/bundle.sh copies this into the
  bundle and rewrites the two version keys from the workspace version, so the
  values below are what a hand-assembled bundle gets, not the release truth.

  There is no usage-description string for screen recording or accessibility
  because macOS has no such key for either: both alerts are worded by the
  system, and no Info.plist entry can change them or pre-request them. What
  those two permissions do need is this bundle. TCC stores a grant against the
  application's designated requirement, and a bare binary launched from a
  terminal has none of its own, so the grant lands on the terminal instead.
  With a Developer ID signature the requirement is the team and bundle
  identifier, and a grant survives updates; with the ad-hoc signature an
  unconfigured build gets, it is that build's cdhash, and every new version
  has to be granted again.

  Local Network is the opposite case: it is honoured from macOS 15 on, and Remu
  trips it on its first connection to any address on the local network, which
  is usually the relay. Denying it blocks that connection outright, so the
  string says so rather than suggesting anything still works without it.

  LSMinimumSystemVersion is 13.1, not ScreenCaptureKit's 12.3: the bindings the
  capture backend uses send selectors that only exist from 13.1, and below that
  they panic. See MIN_MACOS in crates/remu-capture/src/backend.rs.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Remu</string>
	<key>CFBundleExecutable</key>
	<string>remu</string>
	<key>CFBundleIconFile</key>
	<string>Remu</string>
	<key>CFBundleIdentifier</key>
	<string>dev.remu.desk</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Remu</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.1</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Remu uses your local network to reach the relay and the other computer. Without it, Remu cannot connect to anything on this network.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSRequiresAquaSystemAppearance</key>
	<false/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
</dict>
</plist>
