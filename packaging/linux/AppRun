#!/bin/sh
#
# AppImage entry point. linuxdeploy's default AppRun is a symlink straight to
# the binary, which is enough to start it and not enough to explain two things
# the binary cannot explain from inside itself:
#
#   * a library the distribution was supposed to provide is missing, and the
#     loader's message names a soname, not something installable;
#   * the session is Wayland, so this desk can be watched but not driven.
#
# Both are facts about the machine, decided before main() runs.
set -eu

HERE="${APPDIR:-$(dirname "$(readlink -f "$0")")}"
BIN="$HERE/usr/bin/remu"

# Desktop integration tools look for the icon through XDG_DATA_DIRS, so the
# bundle goes first while still falling back to the spec's default.
XDG_DATA_DIRS="$HERE/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export XDG_DATA_DIRS

# Graphics drivers, the X11 and Wayland client libraries, D-Bus, PipeWire and
# the C++ runtime are deliberately not bundled: a second copy of any of them in
# this process disagrees with the kernel, the compositor or the GL driver it
# has to talk to. Only the last three are linked directly — the display stack
# is dlopened, and winit falls back from Wayland to X11 on its own — so those
# three are what ldd can report missing, and each gets a specific hint.
# Package names are the ones on the distributions this build supports, where
# PipeWire's library carries the t64 suffix of the 64-bit time_t transition.
missing=''
if command -v ldd >/dev/null 2>&1; then
    missing="$(ldd "$BIN" 2>/dev/null | sed -n 's/^[[:space:]]*\([^[:space:]]*\) => not found$/\1/p')" || missing=''
fi

if [ -n "$missing" ]; then
    wanted=''
    for soname in $missing; do
        case "$soname" in
            libpipewire-0.3.so.0)
                hint='PipeWire — Debian/Ubuntu: libpipewire-0.3-0t64 · Fedora: pipewire-libs · Arch: pipewire' ;;
            libdbus-1.so.3)
                hint='D-Bus — Debian/Ubuntu: libdbus-1-3 · Fedora: dbus-libs · Arch: dbus' ;;
            libstdc++.so.6)
                hint='the C++ runtime — Debian/Ubuntu: libstdc++6 · Fedora: libstdc++ · Arch: gcc-libs' ;;
            *)
                hint="$soname" ;;
        esac
        wanted="$wanted  $hint
"
    done

    message="Remu cannot start: this system is missing libraries it expects the distribution to provide.

Install:
$wanted
Then run Remu again."

    printf '%s\n' "$message" >&2
    # A double-clicked AppImage has no terminal, so the message has to reach a
    # window if the desktop has either of the usual helpers. Failure to show a
    # dialog must not replace the real error, hence the guards.
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --no-wrap --title='Remu' --text="$message" >/dev/null 2>&1 || true
    elif command -v kdialog >/dev/null 2>&1; then
        kdialog --title 'Remu' --error "$message" >/dev/null 2>&1 || true
    fi
    exit 1
fi

# Input injection is XTest, which a Wayland compositor does not accept; screen
# capture goes through the PipeWire portal and works either way. Printed once,
# on stderr, because it is a limitation and not a failure — a dialog on every
# launch would teach the user to dismiss dialogs.
if [ "${XDG_SESSION_TYPE:-}" = 'wayland' ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
    printf 'remu: Wayland session. Sharing this screen works; letting someone control this desk needs an Xorg session.\n' >&2
fi

exec "$BIN" "$@"
